##### eggers regression to test for pub bias. Regress the model residuals about the "within-study" effect (here, the predicted values of the model) against the precision (inverse of SE). A significant INTERCEPT indicates potenital publication bias

## create data frame first
prediction <- predict(s.meta00)$pred # fitted vals
precision <- log10(1/surv.se$linear.coefs.se) # precision metric
MR <- surv.se$linear.coefs - prediction # model residuals for the so-called "within-study" effect (i.e. like the background rate of "risk"). Recommended by Nakagawa & Santos 2012 Ecol Evol and Nakagawa et al. 2018 Methods in Ecol & Evol
zMR <- MR * precision # standardize model residuals
s.egg.dat <- data.frame(prediction, MR, zMR, precision, surv.se$StudyID, surv.se$Trait.Name, surv.se$grad.diff, surv.se$Species, surv.se$order, surv.se$class) # make this into its own dataframe
colnames(s.egg.dat) <- c('pred', 'MR', 'zMR', 'precision', 'StudyID', 'Trait.Name', 'grad.diff', 'Species', 'order', 'class')

egg.mod00 <- lmer(zMR ~ precision + (1|StudyID/Trait.Name) + (1|Species) + (1|grad.diff) + (1|order) + (1|class), data = s.egg.dat) # eggers regression model
confint(egg.mod00, parm = '(Intercept)') # -0.05299091 0.1169002
summary(egg.mod00)
